{
  "client": "client_mes",
  "table": "md_device",
  "label": "设备台账",
  "observed_via": "db_metadata",
  "observed_at": "2026-11-26",
  "source_path": "postgresql://localhost:5432/fde_client (public.md_device)",
  "key_columns": [
    "equip_no"
  ],
  "renames": {},
  "columns": [
    {
      "name": "equip_no",
      "type": "text",
      "required": true
    },
    {
      "name": "prod_line",
      "type": "text",
      "required": true
    },
    {
      "name": "work_station",
      "type": "text",
      "required": true
    },
    {
      "name": "cam_model",
      "type": "text",
      "required": true
    },
    {
      "name": "lens_spec",
      "type": "text",
      "required": true
    },
    {
      "name": "lamp_type",
      "type": "text",
      "required": true
    },
    {
      "name": "install_dt",
      "type": "date",
      "required": true
    },
    {
      "name": "maint_cycle",
      "type": "smallint",
      "required": true
    }
  ],
  "limits": "库元数据给出类型与必填（is_nullable），列集合可信、空列也可见；值域取 gov.field_registry 的 domain 声明，未声明的不参与判定。",
  "domains": {
    "equip_no": {
      "regex": "^CX-[0-9]{3}$",
      "note": "库里有 CHECK 约束；客户 CSV 里出现过小写 cx-101，两路不一致"
    },
    "install_dt": {
      "format": "%Y-%m-%d",
      "note": "库直连按 ISO 渲染；同一列的客户 CSV 是 %Y/%m/%d，两条路不一样"
    },
    "maint_cycle": {
      "range": [
        1,
        3650
      ],
      "unit": "day"
    }
  }
}
